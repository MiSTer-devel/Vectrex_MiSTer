set_global_assignment -library "pll" -name VERILOG_FILE [file join $::quartus(qip_path) "pll.v"]
set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "*pll:pll|altera_pll:pll_inst*|*"
set_instance_assignment -name PLL_CHANNEL_SPACING "0.0 KHz" -to "*pll:pll|altera_pll:pll_inst*|*"
set_instance_assignment -name PLL_AUTO_RESET ON -to "*pll:pll|altera_pll:pll_inst*|*"
set_instance_assignment -name PLL_BANDWIDTH_PRESET AUTO -to "*pll:pll|altera_pll:pll_inst*|*"
