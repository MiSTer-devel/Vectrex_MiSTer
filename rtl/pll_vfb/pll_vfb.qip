set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "*pll_vfb_core*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_CHANNEL_SPACING "0.0 KHz" -to "*pll_vfb_core*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_AUTO_RESET ON -to "*pll_vfb_core*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_BANDWIDTH_PRESET AUTO -to "*pll_vfb_core*|altera_pll:altera_pll_i*|*"
